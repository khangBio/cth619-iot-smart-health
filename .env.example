HOST=127.0.0.1
PORT=3000
DEVICE_COUNT=6
# Leave empty for local SQLite; Docker uses PostgreSQL.
DATABASE_URL=
SQLITE_PATH=data/health.db
MQTT_URL=mqtt://127.0.0.1:1883
# Host ports exposed by Docker; independent of local demo MQTT_PORT / PORT.
DOCKER_MQTT_PORT=1883
DOCKER_HTTP_PORT=3000
DOCKER_NODE_RED_PORT=1880
# Optional: WOKWI_MQTT_PORT overrides DOCKER_MQTT_PORT when generating firmware.
MQTT_USERNAME=platform
MQTT_PASSWORD=local-demo-only
INGEST_TOKEN=local-ingest-only
SESSION_SECRET=replace-for-shared-deployment
NURSE_PASSWORD=nurse-demo
ADMIN_PASSWORD=admin-demo
EMR_URL=http://127.0.0.1:3000/sandbox/fhir
EMR_TOKEN=local-emr-only
