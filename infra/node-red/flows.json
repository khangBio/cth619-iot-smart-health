[
  {
    "id": "health",
    "type": "tab",
    "label": "Smart Health · IoT integration",
    "disabled": false,
    "info": "MQTT → route telemetry/event/ACK → authenticated ingestion API. API owns transactional validation, PostgreSQL, rules and workflow; commands return via MQTT. Disable direct backend subscription with INGEST_VIA_NODE_RED=true."
  },
  {
    "id": "broker",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "node-red-health",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "telemetry",
    "type": "mqtt in",
    "z": "health",
    "name": "Telemetry + calls + lamp ACK",
    "topic": "hospital/#",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 190,
    "y": 120,
    "wires": [["route"]]
  },
  {
    "id": "route",
    "type": "function",
    "z": "health",
    "name": "Route + ingestion token",
    "func": "if (!/\\/(telemetry|event|ack|status)$/.test(msg.topic)) return null;\ntry { const payload = JSON.parse(msg.payload); msg.url = 'http://api:3000/api/' + (msg.topic.endsWith('/ack') ? 'ack' : msg.topic.endsWith('/status') ? 'device-status' : 'ingest'); msg.headers = {'Content-Type':'application/json', 'Authorization':'Bearer ' + env.get('INGEST_TOKEN')}; msg.payload = {topic:msg.topic,payload}; return msg; } catch(e) { node.warn('Invalid JSON: ' + e.message); return null; }",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 120,
    "wires": [["ingest"]]
  },
  {
    "id": "ingest",
    "type": "http request",
    "z": "health",
    "name": "Validate → store → rules/workflow",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": true,
    "headers": [],
    "x": 800,
    "y": 120,
    "wires": [["response"]]
  },
  {
    "id": "response",
    "type": "function",
    "z": "health",
    "name": "Surface rejected messages",
    "func": "if(msg.statusCode >= 400) node.warn(JSON.stringify({status:msg.statusCode,error:msg.payload})); return null;",
    "outputs": 0,
    "x": 1090,
    "y": 120,
    "wires": []
  },
  {
    "id": "catch",
    "type": "catch",
    "z": "health",
    "name": "Integration errors",
    "scope": null,
    "uncaught": false,
    "x": 200,
    "y": 220,
    "wires": [["debug"]]
  },
  {
    "id": "debug",
    "type": "debug",
    "z": "health",
    "name": "Inspect transport failures",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": false,
    "complete": "error",
    "targetType": "msg",
    "x": 500,
    "y": 220,
    "wires": []
  }
]
